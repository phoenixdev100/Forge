# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Hosted Postgres (Neon / Supabase). Use the POOLED connection string here.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Neon/Supabase poolers cannot run DDL in a transaction. Point migrations at
# the direct (non-pooled) endpoint. Optional - falls back to DATABASE_URL.
SHADOW_DATABASE_URL=""

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV="development"
PORT="4000"
# Comma-separated list of allowed browser origins.
CORS_ORIGINS="http://localhost:5173"
LOG_LEVEL="debug"

# ---------------------------------------------------------------------------
# Auth - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET="replace-me-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-me-with-a-different-long-random-string"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"
# Set to "true" only when server and client are on different sites over HTTPS.
COOKIE_CROSS_SITE="false"
COOKIE_DOMAIN=""

# ---------------------------------------------------------------------------
# Password reset + email delivery
# ---------------------------------------------------------------------------
# With no mail provider configured the reset link is logged to the server
# console in development instead of being emailed. In production the server
# warns at boot and reset requests succeed but no email is delivered.
APP_URL="http://localhost:5173"
RESET_TOKEN_TTL_MINUTES="30"
# none | smtp
MAIL_PROVIDER="none"
# Sender shown in the inbox, e.g. "Forge <you@gmail.com>" - your own address.
MAIL_FROM="Forge <noreply@example.com>"
# Required when MAIL_PROVIDER=smtp. Gmail example:
#   SMTP_HOST="smtp.gmail.com" SMTP_PORT="465" SMTP_SECURE="true"
#   SMTP_USER="you@gmail.com"  SMTP_PASS="your-16-char-app-password"
# Gmail needs an APP password (myaccount.google.com/apppasswords, requires 2FA)
# - your normal account password will not work.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# ---------------------------------------------------------------------------
# Media uploads (exercise demos, progress photos)
# ---------------------------------------------------------------------------
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB="25"

# ---------------------------------------------------------------------------
# Seeding
# ---------------------------------------------------------------------------
# Created/updated by `npm run db:seed` so you can sign in immediately.
SEED_ADMIN_EMAIL="admin@forge.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_DEMO_EMAIL="demo@forge.local"
SEED_DEMO_PASSWORD="ChangeMe123!"
