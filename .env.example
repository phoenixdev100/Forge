# docker-compose reads this file automatically - copy to .env and fill in.

# Postgres password for the bundled database container.
# Keep it URL-safe (letters/digits) - it is interpolated into DATABASE_URL.
DB_PASSWORD="change-me-to-a-long-random-string"

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Generate TWO different values.
JWT_ACCESS_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me-with-a-different-value"

# Public URL the SPA is served on (nginx default is http://localhost:8080).
APP_URL="http://localhost:8080"

# none | smtp - without smtp, password reset emails are only logged.
MAIL_PROVIDER="none"
MAIL_FROM="Forge <noreply@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# Accounts created by `docker compose exec server npm run db:seed`.
SEED_ADMIN_EMAIL="admin@forge.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_DEMO_EMAIL="demo@forge.local"
SEED_DEMO_PASSWORD="ChangeMe123!"
